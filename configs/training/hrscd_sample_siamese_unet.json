{
  "experiment_name": "hrscd_sample_siamese_unet",
  "seed": 42,
  "data": {
    "dataset": "hrscd",
    "root": "D:/桌面/文献/论文/公开数据集/HRSCD_sample_balanced",
    "image_size": 256
  },
  "model": {
    "name": "siamese_unet",
    "params": {
      "base_channels": 32
    }
  },
  "training": {
    "epochs": 50,
    "batch_size": 8,
    "num_workers": 0,
    "pin_memory": true,
    "drop_last": false,
    "optimizer": "adamw",
    "lr": 0.0003,
    "weight_decay": 0.0001,
    "scheduler": {
      "name": "cosine",
      "min_lr": 0.000001
    },
    "pos_weight": 2.0,
    "dice_weight": 1.0,
    "threshold": 0.5,
    "monitor": "f1",
    "monitor_mode": "max",
    "device": "auto",
    "limit_batches": {
      "train": 0,
      "val": 0,
      "test": 0
    }
  },
  "results": {
    "out_dir": "runs/hrscd_sample_siamese_unet"
  }
}
