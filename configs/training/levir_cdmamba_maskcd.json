{
  "experiment_name": "levir_cdmamba_maskcd",
  "seed": 42,
  "data": {
    "dataset": "levir-cd",
    "root": "D:/桌面/文献/论文/公开数据集/datasets",
    "image_size": 256
  },
  "model": {
    "name": "cdmamba_maskcd",
    "params": {
      "embed_dims": [32, 64, 128, 256],
      "depths": [1, 1, 2, 1],
      "expand_ratio": 2.0,
      "query_dim": 256,
      "num_queries": 64,
      "num_heads": 8,
      "decoder_depth": 2
    }
  },
  "training": {
    "epochs": 100,
    "batch_size": 4,
    "num_workers": 0,
    "pin_memory": true,
    "drop_last": false,
    "optimizer": "adamw",
    "lr": 0.0001,
    "weight_decay": 0.0001,
    "scheduler": {
      "name": "cosine",
      "min_lr": 0.000001
    },
    "pos_weight": 2.0,
    "dice_weight": 1.0,
    "threshold": 0.5,
    "monitor": "f1",
    "monitor_mode": "max",
    "device": "auto",
    "limit_batches": {
      "train": 0,
      "val": 0,
      "test": 0
    }
  },
  "results": {
    "out_dir": "runs/levir_cdmamba_maskcd"
  }
}
