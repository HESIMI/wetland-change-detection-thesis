{
  "experiment_name": "levir_maskcd_style",
  "seed": 42,
  "data": {
    "dataset": "levir-cd",
    "root": "D:/桌面/文献/论文/公开数据集/datasets",
    "image_size": 256
  },
  "model": {
    "name": "maskcd_style",
    "params": {
      "embed_dims": [32, 64, 128, 256],
      "depths": [1, 1, 2, 1],
      "num_heads": [1, 2, 4, 8],
      "query_dim": 256,
      "num_queries": 64,
      "decoder_heads": 8,
      "decoder_depth": 2,
      "mask_logit_weight": 0.85,
      "pixel_logit_weight": 0.15
    }
  },
  "training": {
    "epochs": 20,
    "batch_size": 1,
    "num_workers": 0,
    "pin_memory": true,
    "drop_last": false,
    "optimizer": "adamw",
    "lr": 0.0001,
    "weight_decay": 0.0001,
    "scheduler": {
      "name": "cosine",
      "min_lr": 0.000001
    },
    "pos_weight": 2.0,
    "dice_weight": 1.0,
    "threshold": 0.5,
    "monitor": "f1",
    "monitor_mode": "max",
    "device": "auto",
    "limit_batches": {
      "train": 200,
      "val": 50,
      "test": 50
    }
  },
  "results": {
    "out_dir": "runs/local_reduced_levir-cd_maskcd_style"
  }
}
