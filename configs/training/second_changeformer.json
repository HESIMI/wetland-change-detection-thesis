{
  "experiment_name": "second_changeformer",
  "seed": 42,
  "data": {
    "dataset": "second",
    "root": "D:/桌面/文献/论文/公开数据集/SECOND",
    "image_size": 256
  },
  "model": {
    "name": "changeformer",
    "params": {
      "embed_dims": [32, 64, 128, 256],
      "depths": [1, 1, 2, 1],
      "num_heads": [1, 2, 4, 8],
      "decoder_dim": 128
    }
  },
  "training": {
    "epochs": 50,
    "batch_size": 8,
    "num_workers": 0,
    "pin_memory": true,
    "drop_last": false,
    "optimizer": "adamw",
    "lr": 0.0001,
    "weight_decay": 0.01,
    "scheduler": {
      "name": "cosine",
      "min_lr": 0.000001
    },
    "pos_weight": 2.0,
    "dice_weight": 1.0,
    "threshold": 0.5,
    "monitor": "f1",
    "monitor_mode": "max",
    "device": "auto",
    "limit_batches": {
      "train": 0,
      "val": 0,
      "test": 0
    }
  },
  "results": {
    "out_dir": "runs/second_changeformer"
  }
}
